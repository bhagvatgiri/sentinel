# Sentinel environment configuration — copy to `.env` and fill in.
# NEVER commit the real `.env`. All values below are read at runtime;
# no secret is ever stored in code or in the scope file.

# --- LLM providers ---------------------------------------------------------
# Cloud reasoning model (used by the pentest agent phases via the model router)
ANTHROPIC_API_KEY=
# Local models for triage/embeddings (default host shown)
OLLAMA_HOST=http://localhost:11434

# --- Reconnaissance / integrations (all optional) --------------------------
GITHUB_TOKEN=                 # raises GitHub API rate limits during recon
HACKERONE_API_USERNAME=       # for HackerOne report/duplicate tooling
HACKERONE_API_TOKEN=
BRIGHTDATA_API_TOKEN=         # optional proxy for recon
MOBSF_API_URL=                # optional mobile scanning (MobSF)
MOBSF_API_KEY=
NOPECHA_KEY=                  # optional CAPTCHA-solving for authenticated flows

# --- Wordlists / tooling paths (optional overrides) ------------------------
FFUF_WORDLIST=
KITE_WORDLIST=

# --- Runtime knobs (optional) ----------------------------------------------
SENTINEL_RUNS_DIR=            # where run artifacts are written
SENTINEL_OAST_ENDPOINT=       # out-of-band interaction endpoint
SENTINEL_PII_GATE_POLICY=     # PII redaction policy for outputs
SENTINEL_CHROME_BINARY=       # path to Chrome/Chromium for browser-driven checks

# NOTE: per-application test credentials (for authenticated scans) are
# referenced BY NAME from the scope file and exported here, e.g.:
#   EXAMPLE_WS1_CLIENT_ID=...
#   EXAMPLE_WS1_CLIENT_SECRET=...
# Never paste secrets into scope.yaml — only the env-var names live there.
